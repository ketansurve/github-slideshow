# BSLC API configuration. Copy to .env (never commit .env).

NODE_ENV=development            # production on the live server
PORT=8080

# PostgreSQL, created with ENCODING 'UTF8' (Hindi content).
# Local development: `npm run db:dev` prints the URL to use below.
DATABASE_URL=postgresql://postgres:postgres@localhost:54328/bslc_dev

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Rotate it to sign everyone out.
JWT_SECRET=change-me-to-a-long-random-value-change-me
JWT_TTL_SECONDS=900

# Origins allowed to call the API (comma separated). GitHub Pages origin has
# no path: https://ketansurve.github.io
CORS_ORIGINS=http://localhost:4174

# console = OTP printed in this server's log (development only)
# sms     = state SMS gateway — required in production, NOT YET IMPLEMENTED
OTP_DELIVERY=console
OTP_TTL_SECONDS=300
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=30
AUTH_RATE_LIMIT=20
# Suggestions from people who are not on a consultation's participant list
# (only accepted where the consultation allows it), per IP per hour.
PUBLIC_SUBMIT_LIMIT=5

# File storage (local disk driver). Production: replace with object storage.
STORAGE_DIR=./.data/uploads
MAX_UPLOAD_MB=25

# ClamAV daemon. Without it, uploads stay PENDING until an admin releases them.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Set to the number of reverse proxies in front of the API (for correct client IPs in the audit log).
# TRUST_PROXY=1
