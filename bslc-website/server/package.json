{
  "name": "bslc-server",
  "version": "0.1.0",
  "private": true,
  "description": "API for the Bihar State Law Commission website: content, documents, users, consultations, audit log.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:dev": "node scripts/dev-db.cjs",
    "prisma": "prisma",
    "migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "static": "node scripts/static-server.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "typescript": "5.6.3"
  }
}
