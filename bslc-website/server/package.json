{
  "name": "bslc-server",
  "version": "0.1.0",
  "private": true,
  "description": "API for the Bihar State Law Commission website: content, documents, users, consultations, audit log.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:dev": "node scripts/dev-db.cjs",
    "prisma": "prisma",
    "migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "static": "node scripts/static-server.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.9.0",
    "@types/supertest": "6.0.2",
    "embedded-postgres": "18.6.0-beta.19",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "file-type": "16.5.4",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "zod": "3.23.8"
  }
}
